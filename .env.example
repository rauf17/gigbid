# Every variable the system reads. NO real values here. Copy to .env (never commit .env).
APP_ENV=development
APP_SECRET_KEY=replace_me
TOKEN_ENCRYPTION_KEY=replace_me_fernet_key   # encrypts OAuth tokens at rest

# Reviewer account (seeded on API startup)
REVIEWER_EMAIL=reviewer@gigbid.local
REVIEWER_PASSWORD=replace_me_reviewer_password

# Data stores (Postgres port 5433 to avoid collision with other projects; Redis 6380)
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5433/gigbid
REDIS_URL=redis://localhost:6380/0

# Marketplace port: gigsim | upwork
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=replace_me
MARKETPLACE_MCP_URL=http://localhost:8002/mcp
MARKETPLACE_MCP_TOKEN=replace_me
PORTFOLIO_MCP_URL=http://localhost:8001/mcp
WORKSPACE_MCP_URL=http://localhost:8003/mcp

# Live mode (Upwork official MCP, OAuth 2.1)
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:8000/auth/upwork/callback

# GitHub MCP (third-party server, repo ingestion)
GITHUB_TOKEN=

# Models: profile open | paid  (per-node models live in agent/config.yaml, never in code)
MODEL_PROFILE=open
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Tracing (one tool)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid

# Workspace (optional real Google APIs; otherwise local mock)
WORKSPACE_BACKEND=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
