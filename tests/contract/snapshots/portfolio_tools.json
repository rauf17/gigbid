          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "get_case_studyArguments",
      "type": "object"
    },
    "name": "get_case_study",
    "outputSchema": {
      "$defs": {
        "CaseStudyOutput": {
          "description": "Full detail view of a single project case study.",
          "properties": {
            "client_industry": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Client industry sector",
              "title": "Client Industry"
            },
            "date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Completion date",
              "title": "Date"
            },
            "id": {
              "description": "Case study identifier (e.g. cs_01)",
              "title": "Id",
              "type": "string"
            },
            "outcome": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Key measurable outcomes or impact",
              "title": "Outcome"
            },
            "persona": {
              "description": "Persona who authored the case study",
              "title": "Persona",
              "type": "string"
            },
            "project": {
              "description": "Title of the project or engagement",
              "title": "Project",
              "type": "string"
            },
            "skills": {
              "description": "Skills exercised in this project",
              "items": {
                "type": "string"
              },
              "title": "Skills",
              "type": "array"
            },
            "source_path": {
              "description": "Path to source markdown file",
              "title": "Source Path",
              "type": "string"
