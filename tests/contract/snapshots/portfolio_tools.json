              "title": "Persona",
              "type": "string"
            },
            "skills": {
              "description": "Deduplicated skill list sorted by backing evidence count",
              "items": {
                "$ref": "#/$defs/SkillCount"
              },
              "title": "Skills",
              "type": "array"
            },
            "total_skills": {
