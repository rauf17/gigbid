    },
    "description": "Search verified portfolio evidence chunks matching a client job requirement or technical topic.\nWhen to use: Use when analyzing a job description or screening question to find concrete past projects, code samples, case studies, or proposal proof points backing a capability claim.\nWhen NOT to use: Do NOT use if you already have the specific case study ID (use get_case_study instead). Do NOT use to browse the overall skill inventory (use list_skills instead).",
    "inputSchema": {
      "properties": {
        "filters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional metadata filters: type in {cv, case_study, repo_readme, repo_code, review, proposal}, skills list[str], outcome in {won, replied, ignored}",
          "title": "Filters"
        },
        "k": {
          "default": 5,
          "description": "Maximum number of evidence items to return (1..20)",
          "maximum": 20,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "requirement": {
          "description": "Client requirement, query string, or technical capability to search for (3..500 characters)",
          "maxLength": 500,
          "minLength": 3,
          "title": "Requirement",
          "type": "string"
        }
      },
      "required": [
        "requirement"
      ],
      "title": "search_evidenceArguments",
      "type": "object"
    },
    "name": "search_evidence",
    "outputSchema": {
      "$defs": {
        "EvidenceOutputItem": {
          "description": "Normalized evidence item returned by portfolio search tools.",
          "properties": {
