          },
          "required": [
            "id",
            "persona",
            "project",
            "text",
            "source_path"
          ],
          "title": "CaseStudyOutput",
          "type": "object"
        },
        "PortfolioErrorOutput": {
          "description": "Structured error payload for failed tool calls.",
          "properties": {
            "detail": {
              "description": "Human-readable explanation of the error",
              "title": "Detail",
              "type": "string"
            },
            "error": {
              "description": "Error category code (not_found, invalid_argument, persona_not_found)",
              "title": "Error",
              "type": "string"
            },
            "persona": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Persona context during the failure",
              "title": "Persona"
            }
          },
          "required": [
            "error",
            "detail"
          ],
          "title": "PortfolioErrorOutput",
          "type": "object"
        }
      },
      "properties": {
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseStudyOutput"
