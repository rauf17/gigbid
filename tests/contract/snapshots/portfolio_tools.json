              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "ISO date or approximate timeframe",
              "title": "Date"
            },
            "id": {
              "description": "Unique evidence chunk identifier",
              "title": "Id",
              "type": "string"
            },
            "outcome": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Proposal outcome if applicable (won, replied, ignored)",
              "title": "Outcome"
            },
            "project": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Associated project or client initiative",
              "title": "Project"
            },
            "score": {
              "description": "Relevance score (cosine similarity or hybrid score)",
              "title": "Score",
              "type": "number"
            },
            "skills": {
              "description": "Extracted skills evidenced by this chunk",
              "items": {
                "type": "string"
              },
              "title": "Skills",
              "type": "array"
            },
            "source": {
              "description": "Relative file path or origin of the chunk",
              "title": "Source",
              "type": "string"
            },
            "text": {
              "description": "Body excerpt of the evidence",
              "title": "Text",
              "type": "string"
            },
            "type": {
              "description": "Evidence type (cv, case_study, repo_readme, repo_code, review, proposal)",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "source",
            "text",
            "score"
          ],
          "title": "EvidenceOutputItem",
          "type": "object"
        },
        "PortfolioErrorOutput": {
          "description": "Structured error payload for failed tool calls.",
          "properties": {
            "detail": {
              "description": "Human-readable explanation of the error",
              "title": "Detail",
              "type": "string"
            },
            "error": {
              "description": "Error category code (not_found, invalid_argument, persona_not_found)",
              "title": "Error",
              "type": "string"
            },
            "persona": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Persona context during the failure",
              "title": "Persona"
            }
          },
          "required": [
            "error",
            "detail"
          ],
          "title": "PortfolioErrorOutput",
          "type": "object"
        },
        "SearchEvidenceOutput": {
          "description": "Output envelope for search_evidence tool.",
          "properties": {
            "count": {
              "description": "Number of evidence items returned",
              "title": "Count",
              "type": "integer"
            },
            "items": {
              "description": "Top matching evidence items",
              "items": {
                "$ref": "#/$defs/EvidenceOutputItem"
              },
              "title": "Items",
              "type": "array"
            },
            "persona": {
              "description": "Freelancer persona whose portfolio was queried",
              "title": "Persona",
              "type": "string"
            },
            "requirement": {
              "description": "Input requirement or query string",
              "title": "Requirement",
              "type": "string"
            }
          },
          "required": [
            "persona",
            "requirement",
            "count"
          ],
          "title": "SearchEvidenceOutput",
          "type": "object"
        }
      },
      "properties": {
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchEvidenceOutput"
            },
            {
              "$ref": "#/$defs/PortfolioErrorOutput"
            }
          ],
          "title": "Result"
        }
      },
      "required": [
        "result"
      ],
      "title": "search_evidenceOutput",
      "type": "object"
    }
  }
]
